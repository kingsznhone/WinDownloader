<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindowsImageDownloader.Views.Controls.RawFileItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Border
        Padding="14"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowSpacing="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding RawFile.DisplayName, ElementName=Root}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="8,3"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <TextBlock
                        FontSize="12"
                        Text="{Binding RawFile.Architecture, ElementName=Root}" />
                </Border>
                <Border
                    Padding="8,3"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <TextBlock
                        FontSize="12"
                        Text="{Binding RawFile.SizeText, ElementName=Root}" />
                </Border>
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding RawFile.FileName, ElementName=Root}"
                TextTrimming="CharacterEllipsis" />

            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="2"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding RawFile.LanguageLabel, ElementName=Root}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding RawFile.EditionGroupLabel, ElementName=Root}" />
                <TextBlock
                    Grid.Column="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding RawFile.RetailText, ElementName=Root}" />
                <TextBlock
                    Grid.Column="3"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding RawFile.Sha256Short, ElementName=Root}"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Grid.ColumnSpan="2"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding RawFile.FilePath, ElementName=Root}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
