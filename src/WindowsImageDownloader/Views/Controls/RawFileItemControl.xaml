<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindowsImageDownloader.Views.Controls.RawFileItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsImageDownloader.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowsImageDownloader.ViewModels"
    x:Name="Root"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:RawFileItemViewModel, IsDesignTimeCreatable=False}">

    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:RawFileGroupSummaryControl
                Grid.Row="0"
                FileGroup="{Binding FileGroup, ElementName=Root}"
                SubtitleText="{Binding FileGroup.File.FileName, ElementName=Root}"
                HashText="{Binding FileGroup.File.Sha256, ElementName=Root}" />

            <!-- Row 1: Download -->
            <Grid Grid.Row="1">
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding DownloadCommand, ElementName=Root}"
                    CommandParameter="{Binding FileGroup, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                        <TextBlock Text="下载 ESD" />
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Border>
</UserControl>
