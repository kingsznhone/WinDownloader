<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindowsImageDownloader.Views.Controls.RawFileItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsImageDownloader.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsImageDownloader.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Title + badge tags -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding FileGroup.File.DisplayName, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <controls:TagControl
                        Text="{Binding FileGroup.File.LanguageLabel, ElementName=Root}"
                        Type="Primary" />
                    <controls:TagControl
                        Text="{Binding FileGroup.File.EditionGroupLabel, ElementName=Root}"
                        Type="Success" />
                    <controls:TagControl
                        Text="{Binding FileGroup.File.RetailText, ElementName=Root}"
                        Type="{Binding FileGroup.File.RetailTagType, ElementName=Root}" />
                    <controls:TagControl
                        Text="{Binding FileGroup.File.Architecture, ElementName=Root}"
                        Type="{Binding FileGroup.File.ArchTagType, ElementName=Root}" />
                    <controls:TagControl
                        Text="{Binding FileGroup.File.SizeText, ElementName=Root}"
                        Type="Primary" />
                </StackPanel>
            </Grid>

            <!-- Row 1: File name (monospace) -->
            <TextBlock
                Grid.Row="1"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding FileGroup.File.FileName, ElementName=Root}"
                TextTrimming="CharacterEllipsis" />

            <!-- Row 2: Editions chip list -->
            <ItemsControl
                Grid.Row="2"
                ItemsSource="{Binding FileGroup.Editions, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TagControl
                            Text="{Binding}"
                            Type="Default" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Row 3: Download -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding FileGroup.File.Sha256, ElementName=Root}"
                    FontFamily="Consolas" />

                <!--
                    左侧主按钮：以默认格式（ESD）下载
                    右侧箭头：展开选择其他格式
                -->
                <SplitButton
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock Text="下载 ESD" />
                        </StackPanel>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="下载 ESD">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="导出为 WIM">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="导出为 ISO">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE958;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>

        </Grid>
    </Border>
</UserControl>
