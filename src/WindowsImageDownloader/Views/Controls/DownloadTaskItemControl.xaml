<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindowsImageDownloader.Views.Controls.DownloadTaskItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WindowsImageDownloader.Converters"
    xmlns:controls="using:WindowsImageDownloader.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowsImageDownloader.ViewModels"
    x:Name="Root"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:DownloadTaskItemViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:RawFileGroupSummaryControl
                Grid.Row="0"
                FileGroup="{Binding Task.FileGroup}"
                SubtitleText="{Binding Task.FileName}"
                HashText="{Binding Task.Sha256}" />

            <!-- Row 1: Download progress (Queued / Downloading / Verifying) -->
            <Grid
                Grid.Row="1"
                RowSpacing="6"
                Visibility="{Binding ShowDownloadProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding Progress, Mode=OneWay}"
                        IsIndeterminate="{Binding IsVerifying, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Height="6" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding SpeedText, Mode=OneWay}"
                        MinWidth="84"
                        TextAlignment="Right" />

                    <!-- Pause (only while Downloading) -->
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding PauseCommand}"
                        Visibility="{Binding CanPause, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE769;" />
                            <TextBlock x:Uid="DownloadTask_Pause" Text="暂停" />
                        </StackPanel>
                    </Button>

                    <!-- Resume (only while Queued/paused) -->
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ResumeCommand}"
                        Visibility="{Binding CanResume, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE768;" />
                            <TextBlock x:Uid="DownloadTask_Resume" Text="继续" />
                        </StackPanel>
                    </Button>

                    <!-- Cancel -->
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                            <TextBlock Text="{Binding CancelButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status text -->
                <TextBlock
                    Grid.Row="1"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusText, Mode=OneWay}"
                    Visibility="{Binding HasStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Row 2: ISO conversion progress -->
            <Grid
                Grid.Row="2"
                RowSpacing="6"
                Visibility="{Binding ShowIsoProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding IsoMainStatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <ProgressBar
                    Grid.Row="1"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding IsoMainProgress, Mode=OneWay}"
                    Height="6" />

                <TextBlock
                    Grid.Row="2"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding IsoSubStatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding HasIsoSubStatusText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressBar
                    Grid.Row="3"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding IsoSubProgress, Mode=OneWay}"
                    IsIndeterminate="{Binding IsIsoSubProgressIndeterminate, Mode=OneWay}"
                    Height="4" />
            </Grid>

            <!-- Row 3: Operation and error messages -->
            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding OperationMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding HasOperationMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    FontSize="12"
                    Foreground="#E81123"
                    Text="{Binding ErrorMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <!-- Row 4: Action bar – visible once ESD download completes -->
            <Grid
                Grid.Row="4"
                Visibility="{Binding ShowActionBar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Delete (left) -->
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground"                   Color="#E81123" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"        Color="#C50F1F" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed"            Color="#A80000" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled"           Color="#99E81123" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock x:Uid="DownloadTask_DeleteFile" Text="删除文件" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Command="{Binding ConvertToIsoCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8B5;" />
                            <TextBlock Text="{Binding ConvertToIsoButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- Open ESD directory -->
                    <Button Command="{Binding OpenDirectoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE838;" />
                            <TextBlock x:Uid="DownloadTask_OpenDirectory" Text="打开目录" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>

        </Grid>
    </Border>
</UserControl>
