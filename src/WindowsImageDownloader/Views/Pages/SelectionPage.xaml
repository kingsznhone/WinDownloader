<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindowsImageDownloader.Views.Pages.SelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsImageDownloader.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsImageDownloader.Models"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="28">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
            <ProgressRing
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid
            RowSpacing="18"
            Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="产品目录" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    Content="刷新"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Header="语言"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                    MaxDropDownHeight="360"
                    MinWidth="160"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="1"
                    Header="架构"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Architectures, Mode=OneWay}"
                    MaxDropDownHeight="360"
                    MinWidth="140"
                    SelectedItem="{x:Bind ViewModel.SelectedArchitecture, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="2"
                    Header="分组"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.EditionGroups, Mode=OneWay}"
                    MaxDropDownHeight="360"
                    MinWidth="180"
                    SelectedItem="{x:Bind ViewModel.SelectedEditionGroup, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="3"
                    Header="版本"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Editions, Mode=OneWay}"
                    MaxDropDownHeight="360"
                    MinWidth="180"
                    SelectedItem="{x:Bind ViewModel.SelectedEdition, Mode=TwoWay}" />
            </Grid>

            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />

            <Grid Grid.Row="3">
                <ListView
                    ItemsSource="{x:Bind ViewModel.FilteredFiles, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RawFile">
                            <controls:RawFileItemControl RawFile="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="没有匹配的产品目录项"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <StackPanel
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="产品目录读取失败" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <Button
                Command="{x:Bind ViewModel.ReloadCommand}"
                Content="重试" />
        </StackPanel>
    </Grid>
</Page>
