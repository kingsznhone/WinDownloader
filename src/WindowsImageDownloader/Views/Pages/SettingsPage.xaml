<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindowsImageDownloader.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:WindowsImageDownloader.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel, IsDesignTimeCreatable=False}">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="4"  HorizontalAlignment="Stretch">

            <!-- ── 下载设置 ─────────────────────────────────────────────────── -->
            <TextBlock
                x:Uid="Settings_DownloadSection"
                Text="下载"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,12" />

            <!-- 下载目录 -->
            <ctk:SettingsCard x:Uid="Settings_DownloadDirectory" Header="下载目录" Description="ESD 文件与转换输出的保存位置">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE838;" />
                </ctk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox
                        x:Uid="Settings_DownloadDirectoryTextBox"
                        Text="{x:Bind ViewModel.DownloadDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="输入路径或点击浏览…"
                        MinWidth="320"
                        IsReadOnly="False" />
                    <Button
                        x:Uid="Settings_BrowseButton"
                        Content="浏览…"
                        Command="{x:Bind ViewModel.BrowseDownloadDirectoryCommand}" />
                </StackPanel>
            </ctk:SettingsCard>

            <!-- 下载分片数 -->
            <ctk:SettingsCard
                x:Uid="Settings_ChunkCount"
                Header="下载分片数"
                Description="将文件等分为 N 段，每段独立 HTTP Range 请求，断点续传粒度更细（1–256）">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9F5;" />
                </ctk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Slider
                        x:Name="chunkSlider"
                        Minimum="1" Maximum="256" StepFrequency="1"
                        TickFrequency="32" TickPlacement="Outside"
                        Value="{x:Bind ViewModel.DownloadChunkCount, Mode=TwoWay}"
                        Width="240" />
                    <TextBlock
                        VerticalAlignment="Center" MinWidth="36"
                        Text="{x:Bind chunkSlider.Value, Mode=OneWay}" />
                </StackPanel>
            </ctk:SettingsCard>

            <!-- 并发流数 -->
            <ctk:SettingsCard
                x:Uid="Settings_ParallelCount"
                Header="并发流数"
                Description="同时激活的 HTTP 连接数，不超过分片数即可，超过无额外收益（1–16）">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE945;" />
                </ctk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Slider
                        x:Name="parallelSlider"
                        Minimum="1" Maximum="16" StepFrequency="1"
                        TickFrequency="2" TickPlacement="Outside"
                        Value="{x:Bind ViewModel.DownloadParallelCount, Mode=TwoWay}"
                        Width="240" />
                    <TextBlock
                        VerticalAlignment="Center" MinWidth="36"
                        Text="{x:Bind parallelSlider.Value, Mode=OneWay}" />
                </StackPanel>
            </ctk:SettingsCard>

            <!-- 最大并发下载数 -->
            <ctk:SettingsCard
                x:Uid="Settings_MaxConcurrentDownloads"
                Header="最大并发下载数"
                Description="同时运行的下载任务数量上限（1–16）">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </ctk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Slider
                        x:Name="concurrentSlider"
                        Minimum="1" Maximum="16" StepFrequency="1"
                        TickFrequency="4" TickPlacement="Outside"
                        Value="{x:Bind ViewModel.MaxConcurrentDownloads, Mode=TwoWay}"
                        Width="240" />
                    <TextBlock
                        VerticalAlignment="Center" MinWidth="36"
                        Text="{x:Bind concurrentSlider.Value, Mode=OneWay}" />
                </StackPanel>
            </ctk:SettingsCard>

            <!-- ── 界面 ─────────────────────────────────────────────────────── -->
            <TextBlock
                x:Uid="Settings_InterfaceSection"
                Text="界面"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,16,0,12" />

            <!-- 语言 -->
            <ctk:SettingsCard
                x:Uid="Settings_LanguageCard"
                Header="语言"
                Description="更改后重启应用生效">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </ctk:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="languageComboBox"
                    SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                    MinWidth="160">
                    <ComboBoxItem x:Uid="Settings_LanguageAuto" Content="跟随系统" Tag="" />
                    <ComboBoxItem x:Uid="Settings_LanguageEnglish" Content="English" Tag="en-US" />
                    <ComboBoxItem x:Uid="Settings_LanguageChinese" Content="中文（简体）" Tag="zh-CN" />
                </ComboBox>
            </ctk:SettingsCard>

            <ctk:SettingsCard
                x:Uid="Settings_RestartCard"
                Header="重启应用"
                Description="关闭当前窗口并重新启动应用"
                Visibility="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </ctk:SettingsCard.HeaderIcon>
                <Button
                    x:Uid="Settings_RestartButton"
                    Content="重启"
                    Command="{x:Bind ViewModel.RestartAppCommand}" />
            </ctk:SettingsCard>

            <!-- ── 重置 ─────────────────────────────────────────────────────── -->
            <TextBlock
                x:Uid="Settings_AdvancedSection"
                Text="高级"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,16,0,12" />

            <ctk:SettingsCard x:Uid="Settings_ResetCard" Header="重置为默认值" Description="将所有设置恢复为出厂默认值">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;" />
                </ctk:SettingsCard.HeaderIcon>
                <Button
                    x:Uid="Settings_ResetButton"
                    Content="重置"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ResetCommand}" />
            </ctk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
