<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDownloader.Views.Pages.SelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDownloader.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinDownloader.Models"
    xmlns:viewmodels="using:WinDownloader.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:SelectionViewModel, IsDesignTimeCreatable=False}">

    <Grid Padding="36,48,36,36">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
            <ProgressRing
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid
            RowSpacing="18"
            Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                        x:Uid="Selection_Title"
                        Grid.Row="0"
                        FontSize="28"
                        FontWeight="SemiBold"/>
                <Button
                    x:Uid="Selection_ReloadButton"
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Uid="Selection_LanguageFilter"
                    Grid.Column="0"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                    MaxDropDownHeight="360"
                    MinWidth="120"
                    HorizontalAlignment="Stretch"

                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                <ComboBox
                    x:Uid="Selection_ArchitectureFilter"
                    Grid.Column="1"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Architectures, Mode=OneWay}"
                    MaxDropDownHeight="360"
                    MinWidth="120"
                    HorizontalAlignment="Stretch"
                    SelectedItem="{x:Bind ViewModel.SelectedArchitecture, Mode=TwoWay}" />
                </Grid>

            <InfoBar
                x:Uid="Selection_OperationInfo"
                Grid.Row="2"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsOperationMessageOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.OperationSeverity, Mode=OneWay}" />

            <TextBlock
                Grid.Row="3"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />

            <Grid Grid.Row="4">
                <ListView
                    ItemsSource="{x:Bind ViewModel.FilteredGroups, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:RawFileItemViewModel">
                            <controls:RawFileItemControl
                                FileGroup="{x:Bind FileGroup}"
                                DownloadCommand="{x:Bind DownloadCommand}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Uid="Selection_Empty"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <StackPanel
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
            <TextBlock
                x:Uid="Selection_ErrorTitle"
                FontSize="22"
                FontWeight="SemiBold" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <Button
                x:Uid="Selection_RetryButton"
                Command="{x:Bind ViewModel.ReloadCommand}"/>
        </StackPanel>
    </Grid>
</Page>
